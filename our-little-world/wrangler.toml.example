name = "our-little-world"
compatibility_date = "2024-11-01"
pages_build_output_dir = "./public"

# Database (D1) — chạy `wrangler d1 create our-little-world` rồi dán database_id vào đây
[[d1_databases]]
binding = "DB"
database_name = "our-little-world"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# (Tuỳ chọn) R2 để lưu video/nhạc và ảnh chất lượng cao. Cần bật R2 trên tài khoản (có nhập thẻ).
# Nếu không dùng R2, ảnh sẽ được lưu trong D1. Bỏ comment 3 dòng dưới sau khi tạo bucket:
# [[r2_buckets]]
# binding = "BUCKET"
# bucket_name = "our-little-world-media"
